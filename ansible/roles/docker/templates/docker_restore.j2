#!/usr/bin/env bash
set -euo pipefail

# Source directory containing the backup data to restore.
SOURCE={{ backup.backup_path}}
# Target directory where the Docker data will be restored.
TARGET={{ docker.data_path }}
# Resolve the script directory to find docker-control.sh reliably.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCKER_CONTROL_SCRIPT="$SCRIPT_DIR/docker-control.sh"

usage() {
  cat <<EOF
Usage: $0

Restores an rsync backup from $SOURCE into $TARGET.
The current containers are stopped before restore and started again afterward.
EOF
  exit 1
}

require_command() {
  # Ensure a required command is available on the system.
  command -v "$1" >/dev/null 2>&1 || {
    echo "[ERROR] Required command '$1' not found." >&2
    exit 2
  }
}

# Fail if any arguments are provided; this script does not accept arguments.
if [[ $# -ne 0 ]]; then
  usage
fi

# Verify rsync exists before proceeding.
require_command rsync

# Verify the docker-control helper script is executable.
if [[ ! -x "$DOCKER_CONTROL_SCRIPT" ]]; then
  echo "[ERROR] Cannot execute docker-control script: $DOCKER_CONTROL_SCRIPT" >&2
  exit 3
fi

# Ensure the backup source directory exists before restoring.
if [[ ! -d "$SOURCE" ]]; then
  echo "[ERROR] Backup source does not exist: $SOURCE" >&2
  exit 4
fi

echo "[INFO] Stopping containers for restore..."
# Stop all Docker containers before restoring backup data.
"$DOCKER_CONTROL_SCRIPT" stop

echo "[INFO] Restoring backup from $SOURCE to $TARGET"
# Restore the backup with archive mode, preserve metadata, and remove deleted files.
rsync -aHAX --delete --stats --human-readable "$SOURCE"/ "$TARGET"/

echo "[INFO] Restarting containers after restore..."
# Start the containers again after the restore completes.
"$DOCKER_CONTROL_SCRIPT" start

echo "[INFO] Restore completed successfully."

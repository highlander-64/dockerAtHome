#######################################
# Home Assistant - Open source home automation that puts local control and privacy first
# installed via ansible {{ ansible_date_time['date'] }}
#######################################
# network_mode: host enable autscan for devices
# If you select the {{ dockerall.external_network }} network, you have to configure every device manually
#######################################

services:
  homeassistant:
    container_name: homeassistant
    image: ghcr.io/home-assistant/home-assistant:{{ docker.homeassistant }}
    pull_policy: always
    volumes:
      - /srv/docker/data/homeassistant:/config
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    privileged: true
    network_mode: host
    labels:
      - homepage.group=Haus
      - hompepage.icon=homeassistant.png
      - homepage.name=Home Assistant
      - homepage.href=http://{{ main.hostname }}:8123
      - homepage.description=Der ulitmative Smart Home Assistent
      - homepage.showStats=false
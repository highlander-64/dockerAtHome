#######################################
# wud - Whats up Docker
# installed via ansible {{ ansible_date_time['date'] }}
#######################################

networks:
  {{ dockerall.external_network }}:
    name: {{ dockerall.external_network }}
    external: true
  {{ dockerall.internal_network}}:
    name: {{ dockerall.internal_network}}
    external: true

services:
  wud:
    image: getwud/wud:{{ docker.wud }}
    pull_policy: always
    container_name: wud
#    volumes:
#      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - WUD_WATCHER_LOCAL_DISABLE=true
      - WUD_WATCHER_PROXY_HOST=docker-socket-proxy
      - WUD_WATCHER_PROXY_PORT=2375      

# Currently, wud doesn't support subpaths, traefik redirect is not working
#    labels:
#      - traefik.enable=true
#      - traefik.http.routers.wud.entryPoints=web
#      - traefik.http.routers.wud.rule=host(`{{ main.hostname }}`) && PathPrefix(`/wud`)
#      - traefik.http.routers.wud.service=wud
#      - traefik.http.routers.wud.middlewares=wud-stripprefix
#      - traefik.http.middlewares.wud-stripprefix.stripprefix.prefixes=/wud
#      - traefik.http.middlewares.wud-stripprefix.stripprefix.forceslash=true
#      - traefik.http.services.wud.loadbalancer.server.port=3000

    ports:
      - 3000:3000
    restart: unless-stopped
    networks:
      - {{ dockerall.external_network }}
      - {{ dockerall.internal_network }}

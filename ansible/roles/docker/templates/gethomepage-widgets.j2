---
# For configuration options and examples, please see:
# https://gethomepage.dev/configs/info-widgets/

- resources:
    cpu: true
    memory: true
    disk: /

- search:
    provider: duckduckgo
    target: _blank

- datetime:
    locale: de
    format:
      dateStyle: short
      timeStyle: short

- openmeteo:
    label: {{ secret_gethomepage.town }}
    timezone: Europe/Berlin
    units: metric
    latitude: {{ secret_gethomepage.latitude }}
    longitude: {{ secret_gethomepage.longitude }}
    cache: 5

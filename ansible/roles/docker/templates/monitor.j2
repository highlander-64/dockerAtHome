#######################################
# Grafana - Metrics vizualizer
# Prometheus - Metrics collector
# installed via ansible {{ ansible_date_time['date'] }}
#######################################

networks:
  traefik_default:
    name: traefik_default
    external: true

services:
  grafana:
    image: grafana/grafana:{{ docker.grafana }}
    restart: always
    labels:
      - traefik.enable=true
      - traefik.http.routers.grafana.entrypoints=web
      - traefik.http.routers.grafana.rule=host(`{{ main.hostname }}`) && PathPrefix(`/monitor`)
      - traefik.http.routers.grafana.middlewares=grafana-stripprefix
      - traefik.http.middlewares.grafana-stripprefix.stripprefix.prefixes=/monitor
      - traefik.http.services.grafana.loadbalancer.server.port=3000
    networks:
      - traefik_default
    user:
      {{ main.docker_id }}:{{ main.docker_group }}
    environment:
      - GF_SECURITY_ADMIN_USER=${ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${ADMIN_PASSWORD:-admin}
      - GF_DEFAULT_INSTANCE_NAME={{ main.hostname }}/monitor
      - GF_SERVER_ROOT_URL=http://{{ main.hostname }}/monitor
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_AUTH_ANONYMOUS_ENABLED=true
      - GF_AUTH_ANONYMOUS_ORG_NAME=KDS115
      - GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
    volumes:
      - /srv/docker/data/monitor/grafana:/var/lib/grafana

  prometheus:
    image: prom/prometheus:{{ docker.prometheus }}
    restart: always
    labels:
      - traefik.enable=true
      - traefik.http.routers.prometheus.entrypoints=web
      - traefik.http.routers.prometheus.rule=host(`{{ main.hostname }}`)  && PathPrefix(`/prometheus`)
      - traefik.http.services.prometheus.loadbalancer.server.port=9090
    networks:
      - traefik_default
    command:
      - '--config.file=/etc/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=7d'
      - '--web.external-url=http://{{ main.hostname }}/prometheus/'
    volumes:
      - /srv/docker/data/monitor/prometheus:/prometheus
      - /srv/docker/data/monitor/prometheus.yml:/etc/prometheus.yml
    user:
      {{ main.docker_id }}:{{ main.docker_group }}


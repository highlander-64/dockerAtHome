#cloud-config
autoinstall:
  version: 1

  refresh-installer:
    update: true
    channel: latest/edge

  updates: all 

  source:
    id: ubuntu-server-minimal

  keyboard:
    layout: de
  locale: de_DE.UTF-8
  timezone: Europe/Berlin

  ssh:
    install-server: true
    allow-pw: false

  user-data:
    users:
      - name: ansible
        gecos: 'Ansible User'
        ssh_authorized_keys:
          - ssh-rsa  ansible@raspberrypi
        lock_passwd: true
        groups: [adm, cdrom, dip, lxd, plugdev, sudo]
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
      - name: mario
        gecos: 'Ubuntu User'
        ssh_authorized_keys:
          - ssh-rsa  lafontana@web.de
        lock_passwd: true
        groups: [adm, cdrom, dip, lxd, plugdev, sudo]
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL 
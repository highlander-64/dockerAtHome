{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^\\s*cops:\\s*(?<currentValue>[^\\s#]+)\\s*$"],
      "depNameTemplate": "linuxserver/cops",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^\\s*mealie:\\s*(?<currentValue>[^\\s#]+)\\s*$"],
      "depNameTemplate": "ghcr.io/mealie-recipes/mealie",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^\\s*cadvisor:\\s*(?<currentValue>[^\\s#]+)\\s*$"],

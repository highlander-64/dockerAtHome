{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 5am on Saturday"],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*cops:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "linuxserver/cops",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*mealie:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "ghcr.io/mealie-recipes/mealie",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*homeassistant:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "ghcr.io/home-assistant/home-assistant",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*cadvisor:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "gcr.io/cadvisor/cadvisor",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*node_exporter:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "prom/node-exporter",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*grafana:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "grafana/grafana",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*prometheus:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "prom/prometheus",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*traefik:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "traefik",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*wud:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "getwud/wud",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*socket_proxy:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "tecnativa/docker-socket-proxy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*gethomepage:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "ghcr.io/gethomepage/homepage",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*jellyfin:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "jellyfin/jellyfin",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*paperless_ngx:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "ghcr.io/paperless-ngx/paperless-ngx",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^ansible\\/roles\\/docker\\/vars\\/main\\.yml$/"],
      "matchStrings": ["(?m)^[ \\t]*valkey:[ \\t]*(?<currentValue>[^\\s#]+)[ \\t\\r]*$"],
      "depNameTemplate": "valkey/valkey",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchJsonata": ["isBreaking = false"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchDepNames": ["ghcr.io/home-assistant/home-assistant"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "matchDepNames": ["ghcr.io/home-assistant/home-assistant"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    }
  ]
}